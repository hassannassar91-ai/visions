# Copy to .env locally (do not commit .env). On Render, set these in the dashboard.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=droobtech.sa,www.droobtech.sa
DJANGO_CSRF_TRUSTED_ORIGINS=https://droobtech.sa,https://www.droobtech.sa

# Optional: PostgreSQL from Render. If unset, SQLite is used (dev only).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
