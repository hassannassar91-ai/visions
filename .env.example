# Copy to .env locally (do not commit .env). On Render, set these per web service.

# Which site this instance serves: visions-tech | droobtech
SITE_BRAND=droobtech

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false

# Visions Tech (SITE_BRAND=visions-tech)
# DJANGO_ALLOWED_HOSTS=visions-tek.com,www.visions-tek.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://visions-tek.com,https://www.visions-tek.com

# DroobTech (SITE_BRAND=droobtech)
DJANGO_ALLOWED_HOSTS=droobtech.sa,www.droobtech.sa
DJANGO_CSRF_TRUSTED_ORIGINS=https://droobtech.sa,https://www.droobtech.sa

# Optional: PostgreSQL from Render. If unset, SQLite is used (dev only).
# DATABASE_URL=postgres://user:pass@host:5432/dbname
